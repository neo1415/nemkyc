{
  "name": "nem-forms-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "protobufjs": ">=7.5.5",
    "flatted": ">=3.4.1",
