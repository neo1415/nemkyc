  "scripts": {
    "dev": "vite --configLoader runner",
    "dev:web": "vite --configLoader runner",
    "dev:backend": "node scripts/startBackend.cjs",
    "dev:server": "npm run dev:backend",
    "build": "vite build --configLoader runner",
    "build:dev": "vite build --configLoader runner --mode development",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:secrets && npm run test:critical && npm run test:backend",
    "check:secrets": "node scripts/check-secrets.cjs",
    "test:critical": "vitest --configLoader runner --run src/__tests__/customerSubmissionFlow.test.tsx src/__tests__/legacyClaimSubmissionFlow.test.tsx src/__tests__/formDraftPersistence.test.tsx src/__tests__/submissionCatalog.test.ts src/__tests__/sensitiveDataMasking.test.ts src/__tests__/verification-matching/ninMatching.test.ts src/__tests__/identity/templateGeneration.test.ts src/__tests__/securityRulesRegression.test.ts src/__tests__/cac-documents/storageRules.test.ts src/__tests__/cac-documents/firestoreRules.test.ts src/__tests__/gemini-document-verification/successUIDisplay.test.tsx src/services/__tests__/fileService.test.ts src/services/__tests__/simpleVerificationMatcher.test.ts",
    "test:backend": "npm --workspace apps/backend test",
    "test:legacy": "vitest --configLoader runner --run src",
    "test:watch": "vitest --configLoader runner",
    "test:coverage": "vitest --configLoader runner --run --coverage"
  },
